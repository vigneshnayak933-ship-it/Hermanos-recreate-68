function Core.GetFOVReferencePosition()
    local cam = Workspace.CurrentCamera or Camera
    local vpSize = cam and cam.ViewportSize or Vector2.new(1920, 1080)
    local center = Vector2.new(vpSize.X * 0.5, vpSize.Y * 0.5)

    if Config.FOVMode == "Mouse" then
        return UserInputService:GetMouseLocation()
    elseif Config.FOVMode == "Target" and cam then
        local t = State.LockedTarget or State.CurrentTarget
        local tHrp = t and Core.GetRootPart(t)
        if tHrp then
            local sp, onScreen = cam:WorldToViewportPoint(tHrp.Position)
            if onScreen then
                return Vector2.new(sp.X, sp.Y)
            end
        end
    end
    return center
end

function Core.IsWithinFOVCircle(worldPos)
    if Config.SilentAimMode ~= "FOV" or not Config.ShowFOV then
        return true
    end
    local cam = Workspace.CurrentCamera or Camera
    if not cam then return true end
    local screenPos, onScreen = cam:WorldToViewportPoint(worldPos)
    if not onScreen then return false end
    local refCenter = Core.GetFOVReferencePosition()
    local dist2D = (Vector2.new(screenPos.X, screenPos.Y) - refCenter).Magnitude
    return dist2D <= (Config.FOVSize * 0.5)
end

function Core.CanTargetPlayer(plr)
    if not plr or plr == LocalPlayer then return false, "Disable Pvp" end
    if State.BlacklistedTargets[plr.UserId] then return false, "Disable Pvp" end
    if not Core.IsPlayerAlive(plr) then return false, "Disable Pvp" end

    if Config.SkipFriends and State.FriendCache[plr.UserId] == true then
        return false, "Disable Pvp"
    end

    local alliedMarine = (
        LocalPlayer.Team and plr.Team and
        LocalPlayer.Team.Name == "Marines" and plr.Team.Name == "Marines"
    )
    if alliedMarine then return false, "Disable Pvp" end

    local tChar = Core.GetCharacter(plr)
    local hasV4 = tChar and (tChar:FindFirstChild("RaceTransformed") or tChar:GetAttribute("RaceTransformed") == true)
    if Config.SkipRaceV4 and hasV4 then
        return false, "Disable Pvp"
    end

    local pvpState = Core.GetPlayerPvpState(plr)
    if pvpState == "Disable Pvp" then
        return false, pvpState
    end

    return true, pvpState
end

function Core.GetAllCandidatePlayers()
    local list = {}
    local seen = {}

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            seen[plr] = true
            table.insert(list, plr)
        end
    end

    local charsFolder = Workspace:FindFirstChild("Characters")
    if charsFolder then
        for _, charModel in ipairs(charsFolder:GetChildren()) do
            local plr = Players:GetPlayerFromCharacter(charModel) or Players:FindFirstChild(charModel.Name)
            if plr and plr ~= LocalPlayer and not seen[plr] then
                seen[plr] = true
                table.insert(list, plr)
            end
        end
    end

    return list
end

function Core.GetBestTarget()
    local myHrp = Core.GetRootPart(LocalPlayer)
    if not myHrp then return nil end

    local maxScanRange = math.max(Config.AimRange or 1500, 1500)

    if State.LockedTarget then
        local okLock, lockState = Core.CanTargetPlayer(State.LockedTarget)
        if okLock then
            local tHrp = Core.GetRootPart(State.LockedTarget)
            if tHrp and (myHrp.Position - tHrp.Position).Magnitude <= maxScanRange then
                if lockState == "InCombat" or (myHrp.Position - tHrp.Position).Magnitude <= 380 then
                    Core.TagPlayerInCombatWithMe(State.LockedTarget, 45)
                end
                return State.LockedTarget
            end
        end
    end
    State.LockedTarget = nil

    -- Keep the same target locked while actively holding/launching a skill so your move never switches targets mid-cast
    if Core.IsSkillAimLockActive() and State.SkillLockedTarget then
        local okSkillLock = Core.CanTargetPlayer(State.SkillLockedTarget)
        if okSkillLock then
            local tHrp = Core.GetRootPart(State.SkillLockedTarget)
            if tHrp and (myHrp.Position - tHrp.Position).Magnitude <= maxScanRange then
                return State.SkillLockedTarget
            end
        end
    end
    if not Core.IsSkillAimLockActive() then
        State.SkillLockedTarget = nil
    end

    -- Fast 20Hz candidate scan cache so RenderStepped never lags
    local now = os.clock()
    if (now - State.LastTargetScanTick < 0.045) and State.CurrentTarget and Core.IsPlayerAlive(State.CurrentTarget) then
        local okCur = Core.CanTargetPlayer(State.CurrentTarget)
        if okCur then
            return State.CurrentTarget
        end
    end
    State.LastTargetScanTick = now

    local bestMutualFOV     = nil
    local shortestMutualFOV = maxScanRange
    local bestCombatFOV     = nil
    local shortestCombatFOV = maxScanRange
    local bestReadyFOV      = nil
    local shortestReadyFOV  = maxScanRange

    local bestMutual360     = nil
    local shortestMutual360 = maxScanRange
    local bestCombat360     = nil
    local shortestCombat360 = maxScanRange
    local bestReady360      = nil
    local shortestReady360  = maxScanRange

    for _, plr in ipairs(Core.GetAllCandidatePlayers()) do
        local canHit, pvpState = Core.CanTargetPlayer(plr)
        if canHit then
            local tHrp = Core.GetRootPart(plr)
            if tHrp then
                local worldDist = (myHrp.Position - tHrp.Position).Magnitude
                if worldDist <= maxScanRange then
                    local isMutual = (State.InCombatWithMe[plr.UserId] and now < State.InCombatWithMe[plr.UserId])
                    local inFOV = Core.IsWithinFOVCircle(tHrp.Position)

                    if inFOV then
                        if isMutual and pvpState == "InCombat" and worldDist <= shortestMutualFOV then
                            shortestMutualFOV = worldDist
                            bestMutualFOV = plr
                        elseif pvpState == "InCombat" and worldDist <= shortestCombatFOV then
                            shortestCombatFOV = worldDist
                            bestCombatFOV = plr
                        elseif worldDist <= shortestReadyFOV then
                            shortestReadyFOV = worldDist
                            bestReadyFOV = plr
                        end
                    end

                    if isMutual and pvpState == "InCombat" and worldDist <= shortestMutual360 then
                        shortestMutual360 = worldDist
                        bestMutual360 = plr
                    elseif pvpState == "InCombat" and worldDist <= shortestCombat360 then
                        shortestCombat360 = worldDist
                        bestCombat360 = plr
                    elseif worldDist <= shortestReady360 then
                        shortestReady360 = worldDist
                        bestReady360 = plr
                    end
                end
            end
        end
    end

    local chosen = bestMutualFOV
        or bestCombatFOV
        or bestReadyFOV
        or bestMutual360
        or bestCombat360
        or bestReady360

    if chosen then
        local tHrp = Core.GetRootPart(chosen)
        if tHrp and (myHrp.Position - tHrp.Position).Magnitude <= 380 then
            State.CombatTaggedPlayers[chosen.UserId] = math.max(State.CombatTaggedPlayers[chosen.UserId] or 0, now + 45)
        end
    end

    return chosen
end

function Core.ExecuteServerHop()
    if os.clock() - State.LastServerHopTick < 8 then return end
    State.LastServerHopTick = os.clock()
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet(
            "https://games.roblox.com/v1/games/" .. tostring(State.PlaceId) .. "/servers/Public?sortOrder=Asc&limit=100"
        ))
        if servers and servers.data then
            for _, srv in ipairs(servers.data) do
                if srv.playing < (srv.maxPlayers - 2) and srv.id ~= game.JobId then
                    TeleportService:TeleportToPlaceInstance(State.PlaceId, srv.id, LocalPlayer)
                    break
                end
            end
        end
    end)
end

