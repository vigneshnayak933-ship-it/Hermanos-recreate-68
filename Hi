-- Smart Origin-Preserving & Target-Snapping Argument Rewriter for Swords (CDK), Melee (Godhuman), Fruits (Tiger) & Guns
function Core.RewriteAimArg(val, depth)
    depth = depth or 0
    if depth > 2 then return val end

    local tPos   = SilentCache.TargetPos
    local oPos   = SilentCache.OriginPos
    local cPos   = SilentCache.CameraPos
    local uDir   = SilentCache.UnitDir
    local hitCF  = SilentCache.HitCFrame

    if typeof(val) == "Vector3" then
        local mag = val.Magnitude
        if mag >= 0.90 and mag <= 1.10 then
            return uDir
        elseif mag > 3 then
            return tPos
        end
        return val
    elseif typeof(val) == "CFrame" then
        local p = val.Position
        -- If the CFrame origin is near the character or camera (e.g. Sword/Melee slash origin or Camera CFrame), preserve its origin and look at TargetPos
        if ((p - oPos).Magnitude <= 18.0 or (p - cPos).Magnitude <= 18.0) and (tPos - p).Magnitude > 0.1 then
            return CFrame.lookAt(p, tPos)
        else
            return hitCF
        end
    elseif typeof(val) == "Ray" then
        local rOrig = val.Origin
        local rLen  = math.max(val.Direction.Magnitude, 1000)
        local rDiff = tPos - rOrig
        local rDir  = (rDiff.Magnitude > 0.001) and rDiff.Unit or uDir
        return Ray.new(rOrig, rDir * rLen)
    elseif type(val) == "table" then
        local copy = {}
        for k, v in pairs(val) do
            copy[k] = Core.RewriteAimArg(v, depth + 1)
        end
        return copy
    end
    return val
end

do
    local NamecallHooked = false
    local IndexHooked    = false

    local function OnNamecallHook(oldNamecall, self, ...)
        if not checkcaller() then
            local method = getnamecallmethod()

            -- 1. RemoteEvent / RemoteFunction Interception
            if method == "FireServer" or method == "InvokeServer" then
                local a1, a2, a3, a4, a5, a6 = ...
                if type(a1) == "string" and type(a2) == "number" and type(a4) == "table" and (type(a6) == "string" or type(a5) == "string") then
                    NetHitAuth.Remote     = self
                    NetHitAuth.HitToken   = a1
                    NetHitAuth.SessionId  = a2
                    NetHitAuth.SessionHex = type(a6) == "string" and a6 or a5
                    NetHitAuth.Captured   = true
                end

                local rName = self.Name
                if rName == "CommE" then
                    if a1 == "Soru" or (Core.IsCallerSoruScript() and a1 == "MousePos") then
                        if Config.SoruSilent and SilentCache.Active and (SilentCache.TargetPos - SilentCache.OriginPos).Magnitude <= Config.SoruSilentRange then
                            Core.TryExecuteSoruSilentTeleport()
                            local args = { ... }
                            local nArgs = select("#", ...)
                            if typeof(args[2]) == "CFrame" then
                                args[2] = SilentCache.HitCFrame
                            elseif typeof(args[2]) == "Vector3" then
                                args[2] = SilentCache.TargetPos
                            end
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNamecall(self, unpack(args, 1, nArgs))
                        end
                        return oldNamecall(self, ...)
                    elseif a1 == "MousePos" and Config.SilentAim and SilentCache.Active then
                        local args = { ... }
                        local nArgs = select("#", ...)
                        if typeof(args[2]) == "CFrame" then
                            args[2] = SilentCache.HitCFrame
                        else
                            args[2] = SilentCache.TargetPos
                        end
                        if setnamecallmethod then setnamecallmethod(method) end
                        return oldNamecall(self, unpack(args, 1, nArgs))
                    end

                elseif Config.SilentAim and SilentCache.Active then
                    local isToolChild = (self.Parent and self.Parent:IsA("Tool"))
                    if isToolChild or rName == "RemoteEvent" or rName == "RemoteFunction" or rName == "LeftClickRemote" or rName == "ShootGunEvent" then
                        local now = os.clock()
                        State.LastSkillFireTick   = now
                        State.LastSkillActionTick = now
                        State.SkillAimEndTick     = math.max(State.SkillAimEndTick or 0, now + 1.25)

                        local activeTarget = State.LockedTarget or State.SkillLockedTarget or State.CurrentTarget
                        if activeTarget then
                            State.SkillLockedTarget = activeTarget
