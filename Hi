function Core.GetPlayerPvpState(plr)
    local char = Core.GetCharacter(plr)
    local hum  = Core.GetHumanoid(plr)
    local hrp  = Core.GetRootPart(plr)
    if not char or not hum or not hrp or hum.Health <= 0 then
        if plr then
            State.CombatTaggedPlayers[plr.UserId] = nil
            State.InCombatWithMe[plr.UserId] = nil
        end
        return "Disable Pvp"
    end

    if char:FindFirstChildOfClass("ForceField") or
       char:GetAttribute("PvpDisabled") == true or
       plr:GetAttribute("PvpDisabled") == true or
       char:FindFirstChild("PvpDisabled") or
       plr:FindFirstChild("PvpDisabled") then
        State.CombatTaggedPlayers[plr.UserId] = nil
        State.InCombatWithMe[plr.UserId] = nil
        return "Disable Pvp"
    end

    if Core.IsPlayerInActiveCombat(plr, char, hum) then
        return "InCombat"
    end

    if char:GetAttribute("InSafeZone") == true or
       plr:GetAttribute("InSafeZone") == true or
       char:FindFirstChild("InSafeZone") or
       char:FindFirstChild("SafeZone") or
       Core.IsPositionInSafeZone(hrp.Position) then
        return "Disable Pvp"
    end

    return "Ready Pvp"
end

