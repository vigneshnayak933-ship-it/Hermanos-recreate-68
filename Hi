function Core.GetCombatActiveController()
    if State.CachedCombatCtrl and (os.clock() - State.LastCombatCtrlScan < 3.5) then
        return State.CachedCombatCtrl
    end
    State.LastCombatCtrlScan = os.clock()

    pcall(function()
        local cfModule = LocalPlayer:FindFirstChild("PlayerScripts") and LocalPlayer.PlayerScripts:FindFirstChild("CombatFramework")
        if cfModule and debug and debug.getupvalues then
            local ok, cfTable = pcall(require, cfModule)
            if ok and cfTable then
                for _, up in pairs(debug.getupvalues(cfTable)) do
                    if type(up) == "table" and up.activeController then
                        State.CachedCombatCtrl = up.activeController
                        return
                    end
                end
            end
        end
    end)

    if State.CachedCombatCtrl then return State.CachedCombatCtrl end

    pcall(function()
        for _, fn in pairs(getgc(true)) do
            if type(fn) == "table" and rawget(fn, "activeController") then
                State.CachedCombatCtrl = rawget(fn, "activeController")
                return
            elseif type(fn) == "function" and debug and debug.getupvalues then
                local ok, ups = pcall(debug.getupvalues, fn)
                if ok and ups then
                    for _, upVal in pairs(ups) do
                        if type(upVal) == "table" and rawget(upVal, "activeController") then
                            State.CachedCombatCtrl = rawget(upVal, "activeController")
                            return
                        end
                    end
                end
            end
        end
    end)

    return State.CachedCombatCtrl
end

function Core.GenerateCombatSessionID()
    local sessionStr = nil
    pcall(function()
        local renv = getrenv and getrenv() or _G
        local sendFn = (renv and renv._G and renv._G.SendHitsToServer) or _G.SendHitsToServer
        if type(sendFn) == "function" and debug and debug.getupvalues then
            local ups = debug.getupvalues(sendFn)
            if ups and ups[1] then
                local uidSlice = tostring(LocalPlayer.UserId):sub(2, 4)
                local memSlice = tostring(ups[1]):sub(11, 15)
                sessionStr = uidSlice .. memSlice
            end
        end
    end)
    if not sessionStr or #sessionStr < 4 then
        pcall(function()
            local uidSlice = tostring(LocalPlayer.UserId):sub(2, 4)
            local coSlice  = tostring(coroutine.running()):sub(11, 15)
            sessionStr = uidSlice .. coSlice
        end)
    end
    return sessionStr
end

