end

function Core.Collect360AuraTargets(myChar, myPos, maxRadius)
    local othersEnemies = {}
    local addedModels   = {}
    local primaryPart   = nil
    local closestDist   = maxRadius

    local function TryAddModel(model, isPlayerPlr)
        if not model or model == myChar or addedModels[model] then return end
        local hum  = model:FindFirstChildOfClass("Humanoid")
        local hrp  = model:FindFirstChild("HumanoidRootPart")
        local head = model:FindFirstChild("Head") or hrp or model:FindFirstChild("UpperTorso") or model:FindFirstChild("LowerTorso")
        local hitPart = head or hrp
        if not hum or not hitPart or hum.Health <= 0 then return end

        local dist = (hitPart.Position - myPos).Magnitude
        if dist > maxRadius then return end

        if isPlayerPlr then
            local canHit, pvpState = Core.CanTargetPlayer(isPlayerPlr)
            if not canHit or pvpState == "Disable Pvp" then return end
            Core.TagPlayerInCombatWithMe(isPlayerPlr, 65)
        end

        addedModels[model] = true
        table.insert(othersEnemies, { model, hitPart })

        if dist <= closestDist or not primaryPart then
            closestDist = dist
            primaryPart = hitPart
        end
    end

    local enemiesFolder = Workspace:FindFirstChild("Enemies")
    if enemiesFolder then
        for _, npc in ipairs(enemiesFolder:GetChildren()) do
            TryAddModel(npc, nil)
        end
    end

    local localSafe = Core.IsLocalPlayerInsideSafeZone()
    for _, plr in ipairs(Core.GetAllCandidatePlayers()) do
        local char = Core.GetCharacter(plr)
        if char then
            local pvpState = Core.GetPlayerPvpState(plr)
            if not localSafe or pvpState == "InCombat" then
                TryAddModel(char, plr)
            end
        end
    end

    return primaryPart, othersEnemies
end

function Core.ExecuteFastAttack()
    if not Config.AttackAura then return end
    if Core.IsSkillAimLockActive() then return end
    if not Core.IsPlayerAlive(LocalPlayer) then return end

    local myChar = Core.GetCharacter(LocalPlayer)
    local myHrp  = Core.GetRootPart(LocalPlayer)
    if not myChar or not myHrp then return end

    local equippedTool = myChar:FindFirstChildOfClass("Tool")
    if not equippedTool or equippedTool.ToolTip == "Gun" then return end

    local basePart, othersEnemies = Core.Collect360AuraTargets(myChar, myHrp.Position, 68)
    if not basePart or #othersEnemies == 0 then return end

    if not State.RegisterAttack or not State.RegisterHit then
        Core.ResolveCombatNet()
    end

    local sessionID = Core.GenerateCombatSessionID()

    if State.RegisterAttack then
        pcall(function()
            State.RegisterAttack:FireServer(0)
        end)
    end

    pcall(function()
        local renv = getrenv and getrenv() or _G
        local sendFn = (renv and renv._G and renv._G.SendHitsToServer) or _G.SendHitsToServer
        if type(sendFn) == "function" then
            sendFn(basePart, othersEnemies)
        end
    end)

    if State.RegisterHit then
        pcall(function()
            if sessionID then
                State.RegisterHit:FireServer(basePart, othersEnemies, nil, sessionID)
            else
                State.RegisterHit:FireServer(basePart, othersEnemies)
            end
        end)
    end

    if NetHitAuth.Captured and NetHitAuth.Remote and NetHitAuth.Remote.Parent then
        local meshOrHead = basePart.Parent and (basePart.Parent:FindFirstChildWhichIsA("MeshPart") or basePart) or basePart
        local obfArgs = {
            NetHitAuth.HitToken,
            NetHitAuth.SessionId,
            meshOrHead,
            othersEnemies,
            [6] = NetHitAuth.SessionHex
        }
        pcall(function()
            NetHitAuth.Remote:FireServer(unpack(obfArgs, 1, 6))
        end)
    end

    local leftClickRemote = equippedTool:FindFirstChild("LeftClickRemote")
    if leftClickRemote then
        local diff = basePart.Position - myHrp.Position
        local dir = (diff.Magnitude > 0.001) and diff.Unit or myHrp.CFrame.LookVector
        State.ComboCounter = (State.ComboCounter % 4) + 1
        pcall(function()
            leftClickRemote:FireServer(dir, State.ComboCounter, true)
        end)
    end

    local ac = Core.GetCombatActiveController()
    if ac then
        pcall(function()
            ac.timeToNextAttack = 0
            ac.attacking = false
            ac.blocking = false
            ac.increment = 3
            ac.hitboxMagnitude = 68
        end)
    end
end

function Core.PatchSoruAndGeppoGC()
    local char = Core.GetCharacter(LocalPlayer)
    if not char then return end
    local soruScript  = char:FindFirstChild("Soru")
    local geppoScript = char:FindFirstChild("Geppo")
    pcall(function()
        for _, fn in pairs(getgc()) do
            if type(fn) == "function" then
                local envOk, env = pcall(getfenv, fn)
                if envOk and env and (env.script == soruScript or env.script == geppoScript) then
                    local upOk, ups = pcall(debug.getupvalues, fn)
                    if upOk and ups then
                        for _, upVal in pairs(ups) do
                            if type(upVal) == "table" then
                                if upVal.LastUse then upVal.LastUse = 0 end
                                if upVal.Cooldown then upVal.Cooldown = 0 end
                                if upVal.SkyJump then upVal.SkyJump = 0 end
                            end
                        end
                    end
                end
            end
        end
    end)
end

