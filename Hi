                        NetHitAuth.SessionId  = a2
                        NetHitAuth.SessionHex = type(a6) == "string" and a6 or a5
                        NetHitAuth.Captured   = true
                    end

                    local rName = self.Name
                    if rName == "CommE" then
                        if a1 == "Soru" or (Core.IsCallerSoruScript() and a1 == "MousePos") then
                            if Config.SoruSilent and SilentCache.Active and (SilentCache.TargetPos - SilentCache.OriginPos).Magnitude <= Config.SoruSilentRange then
                                Core.TryExecuteSoruSilentTeleport()
                                local args = { ... }
                                local nArgs = select("#", ...)
                                if typeof(args[2]) == "CFrame" then
                                    args[2] = SilentCache.HitCFrame
                                elseif typeof(args[2]) == "Vector3" then
                                    args[2] = SilentCache.TargetPos
                                end
                                return oldFireServer(self, unpack(args, 1, nArgs))
                            end
                            return oldFireServer(self, ...)
                        elseif a1 == "MousePos" and Config.SilentAim and SilentCache.Active then
                            local args = { ... }
                            local nArgs = select("#", ...)
                            if typeof(args[2]) == "CFrame" then
                                args[2] = SilentCache.HitCFrame
                            else
                                args[2] = SilentCache.TargetPos
                            end
                            return oldFireServer(self, unpack(args, 1, nArgs))
                        end
                    elseif Config.SilentAim and SilentCache.Active then
                        local isToolChild = (self.Parent and self.Parent:IsA("Tool"))
                        if isToolChild or rName == "RemoteEvent" or rName == "LeftClickRemote" or rName == "ShootGunEvent" then
                            local now = os.clock()
                            State.LastSkillFireTick   = now
                            State.LastSkillActionTick = now
                            State.SkillAimEndTick     = math.max(State.SkillAimEndTick or 0, now + 1.25)
                            Core.AlignSkillGyroToTarget()
                            local activeTarget = State.LockedTarget or State.SkillLockedTarget or State.CurrentTarget
                            if activeTarget then
                                State.SkillLockedTarget = activeTarget
                                Core.TagPlayerInCombatWithMe(activeTarget, 65)
                            end
                            local args = { ... }
                            local nArgs = select("#", ...)
                            if rName == "LeftClickRemote" then
                                if typeof(args[1]) == "Vector3" then
                                    args[1] = SilentCache.UnitDir
                                elseif typeof(args[1]) == "CFrame" then
                                    args[1] = SilentCache.HitCFrame
                                end
                            else
                                for i = 1, nArgs do
                                    args[i] = Core.RewriteAimArg(args[i])
                                end
                            end
                            return oldFireServer(self, unpack(args, 1, nArgs))
                        end
                    end
                end
                return oldFireServer(self, ...)
            end))
            dummyRemote:Destroy()
        end)
    end
end

