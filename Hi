function Core.SaveConfiguration()
    if not writefile then return false end
    local ok = false
    pcall(function()
        if makefolder and isfolder and not isfolder(ConfigFolderName) then
            makefolder(ConfigFolderName)
        end
        local serializable = {}
        for k, v in pairs(Config) do
            if typeof(v) == "EnumItem" then
                serializable[k] = v.Name
            else
                serializable[k] = v
            end
        end
        writefile(ConfigFileName, HttpService:JSONEncode(serializable))
        ok = true
    end)
    return ok
end

function Core.LoadConfiguration()
    if not readfile or not isfile or not isfile(ConfigFileName) then
        return false
    end
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(readfile(ConfigFileName))
    end)
    if ok and type(decoded) == "table" then
        for k, v in pairs(decoded) do
            if DefaultConfig[k] ~= nil then
                if typeof(DefaultConfig[k]) == "EnumItem" and type(v) == "string" and Enum.KeyCode[v] then
                    Config[k] = Enum.KeyCode[v]
                else
                    Config[k] = v
                end
            end
        end
        return true
    end
    return false
end

