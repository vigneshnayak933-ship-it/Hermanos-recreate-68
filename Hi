                        end

                        local args = { ... }
                        local nArgs = select("#", ...)
                        if rName == "LeftClickRemote" then
                            if typeof(args[1]) == "Vector3" then
                                args[1] = SilentCache.UnitDir
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = SilentCache.HitCFrame
                            end
                        elseif rName == "ShootGunEvent" then
                            if typeof(args[1]) == "Vector3" then
                                args[1] = SilentCache.TargetPos
                            elseif typeof(args[1]) == "CFrame" then
                                args[1] = SilentCache.HitCFrame
                            else
                                for i = 1, nArgs do
                                    args[i] = Core.RewriteAimArg(args[i])
                                end
                            end
                        else
                            for i = 1, nArgs do
                                args[i] = Core.RewriteAimArg(args[i])
                            end
                        end
                        if setnamecallmethod then
                            setnamecallmethod(method)
                        end
                        return oldNamecall(self, unpack(args, 1, nArgs))
                    end
                end

            -- 2. Background Camera Ray & Workspace Aim Raycast Interception (For CDK, Godhuman, Sword/Melee & Gun rays)
            elseif Config.SilentAim and SilentCache.Active and not Core.IsCameraOrControlScript() and not Core.IsCallerSoruScript() then
                if (self == Camera or (typeof(self) == "Instance" and self:IsA("Camera"))) and (method == "ScreenPointToRay" or method == "ViewportPointToRay") then
                    return Ray.new(SilentCache.CameraPos, SilentCache.CamUnitDir)
                elseif self == Workspace or (typeof(self) == "Instance" and self:IsA("WorldRoot")) then
                    if method == "FindPartOnRayWithIgnoreList" or method == "FindPartOnRay" or method == "FindPartOnRayWithWhitelist" then
                        local rArg = select(1, ...)
                        if typeof(rArg) == "Ray" and rArg.Direction.Magnitude >= 25 then
                            local args = { ... }
                            local nArgs = select("#", ...)
                            local orig = rArg.Origin
                            local diff = SilentCache.TargetPos - orig
                            local dir  = (diff.Magnitude > 0.001) and diff.Unit or SilentCache.UnitDir
                            args[1] = Ray.new(orig, dir * math.max(rArg.Direction.Magnitude, (SilentCache.TargetPos - orig).Magnitude + 25))
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNamecall(self, unpack(args, 1, nArgs))
                        end
                    elseif method == "Raycast" then
                        local orig, dirVec = ...
                        if typeof(orig) == "Vector3" and typeof(dirVec) == "Vector3" and dirVec.Magnitude >= 25 then
                            local args = { ... }
                            local nArgs = select("#", ...)
                            local diff = SilentCache.TargetPos - orig
                            local uDir = (diff.Magnitude > 0.001) and diff.Unit or SilentCache.UnitDir
                            args[2] = uDir * math.max(dirVec.Magnitude, diff.Magnitude + 25)
                            if setnamecallmethod then setnamecallmethod(method) end
                            return oldNamecall(self, unpack(args, 1, nArgs))
                        end
                    end
                end
            end
        end
        return oldNamecall(self, ...)
    end

    local function OnIndexHook(oldIndex, self, key)
        if not checkcaller() and Core.ShouldRedirectAimForCaller() then
            -- 1. Mouse Redirect
            if self == Mouse then
                if key == "Hit" or key == "hit" then
                    if Core.IsCallerSoruScript() and Config.SoruSilent then
                        Core.TryExecuteSoruSilentTeleport()
                    end
                    return SilentCache.HitCFrame
                elseif key == "Target" or key == "target" then
                    return SilentCache.AimPart
                elseif key == "UnitRay" or key == "unitRay" then
                    return Ray.new(SilentCache.CameraPos, SilentCache.CamUnitDir)
                elseif key == "Origin" or key == "origin" then
                    return SilentCache.CamLookCFrame
                end
            -- 2. Background Camera Lock (Locks Camera CFrame in the background for Tools/Skills while your real screen camera stays untouched!)
            elseif self == Camera or (typeof(self) == "Instance" and self:IsA("Camera")) then
                if key == "CFrame" or key == "CoordinateFrame" then
                    return SilentCache.CamLookCFrame
                elseif key == "Focus" then
                    return SilentCache.HitCFrame
                end
            end
        end
        return oldIndex(self, key)
    end

    -- 1. Try hookmetamethod first
    if hookmetamethod then
        pcall(function()
            local oldNamecall
            oldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
                return OnNamecallHook(oldNamecall, self, ...)
            end))
            NamecallHooked = true
        end)

        pcall(function()
            local oldIndex
            oldIndex = hookmetamethod(game, "__index", newcclosure(function(self, key)
                return OnIndexHook(oldIndex, self, key)
            end))
            IndexHooked = true
        end)
    end

    -- 2. Fallback to getrawmetatable + setreadonly if hookmetamethod is partial/unavailable
    if (not NamecallHooked or not IndexHooked) and getrawmetatable and setreadonly then
        pcall(function()
            local rawMt = getrawmetatable(game)
            setreadonly(rawMt, false)
            if not NamecallHooked and rawMt.__namecall then
