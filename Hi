-- Detects Roblox's internal Camera/Control scripts so Poppercam & ClassicCamera NEVER move or zoom your screen camera
function Core.IsCameraOrControlScript()
    local ok, callerScr = pcall(getcallingscript)
    if not ok or not callerScr or typeof(callerScr) ~= "Instance" then
        return false
    end
    local n = callerScr.Name
    if n == "Poppercam" or n == "ZoomController" or n == "ClassicCamera" or n == "BaseCamera" or
       n == "CameraModule" or n == "TransparencyController" or n == "ControlModule" or
       n == "CameraScript" or n == "OrbitalCamera" or n == "VehicleCamera" then
        return true
    end
    if callerScr:FindFirstAncestor("PlayerModule") or callerScr:FindFirstAncestor("CameraScript") or callerScr:FindFirstAncestor("Chat") then
        return true
    end
    return false
end

function Core.ShouldRedirectAimForCaller()
    if Core.IsCameraOrControlScript() then
        return false
    end
    if Core.IsCallerSoruScript() then
        if not Config.SoruSilent or not SilentCache.Active then
            return false
        end
        local dist = (SilentCache.TargetPos - SilentCache.OriginPos).Magnitude
        return dist <= Config.SoruSilentRange
    end
    return Config.SilentAim and SilentCache.Active
end

function Core.TryExecuteSoruSilentTeleport()
    if not Config.SoruSilent then return false end
    if os.clock() - State.LastSoruTPExecution < 0.25 then return false end
    local target = State.LockedTarget or State.CurrentTarget
    if target and Core.IsPlayerAlive(target) then
        local myHrp = Core.GetRootPart(LocalPlayer)
        local tHrp  = Core.GetRootPart(target)
        if myHrp and tHrp then
            local dist = (myHrp.Position - tHrp.Position).Magnitude
            if dist <= Config.SoruSilentRange then
                State.LastSoruTPExecution = os.clock()
                Core.TagPlayerInCombatWithMe(target, 65)
                task.delay(0.03, function()
                    if myHrp and myHrp.Parent and tHrp and tHrp.Parent then
                        myHrp.CFrame = tHrp.CFrame * CFrame.new(0, 0, 3.5)
                    end
                end)
                return true
            end
        end
    end
    return false
end

-- Fast O(1) SilentCache Updater with full 3D Vertical & Horizontal Prediction (tracks jumping/airborne players up & down!)
function Core.UpdateSilentCacheFast()
    local myHrp = Core.GetRootPart(LocalPlayer)
    local activeTarget = State.LockedTarget or State.SkillLockedTarget or State.CurrentTarget
    if activeTarget and not Core.IsPlayerAlive(activeTarget) then
        State.SkillLockedTarget = nil
        activeTarget = State.LockedTarget or State.CurrentTarget
    end

    local cam = Workspace.CurrentCamera or Camera
    if (Config.SilentAim or Config.SoruSilent) and activeTarget and Core.IsPlayerAlive(activeTarget) and myHrp then
        local tChar = Core.GetCharacter(activeTarget)
        local aimPart = (tChar and tChar:FindFirstChild(Config.AimPart)) or Core.GetRootPart(activeTarget)
        if aimPart and aimPart:IsA("BasePart") then
            local vel = aimPart.AssemblyLinearVelocity or aimPart.Velocity or Vector3.zero
            -- Full 3D velocity prediction so when the target jumps up/down or dashes, held moves track vertically & horizontally
            local predVel = Vector3.new(
                vel.X * Config.PredictionFactor,
                math.clamp(vel.Y, -115, 115) * (Config.PredictionFactor * 0.88),
                vel.Z * Config.PredictionFactor
            )
            local predPos = aimPart.Position + predVel
            local origPos = myHrp.Position
            local diff = predPos - origPos
            local uDir = (diff.Magnitude > 0.001) and diff.Unit or Vector3.new(0, 0, -1)

            local flatTarget = Vector3.new(predPos.X, origPos.Y, predPos.Z)
            local flatCF = ((flatTarget - origPos).Magnitude > 0.05)
                and CFrame.lookAt(origPos, flatTarget)
                or CFrame.lookAt(origPos, origPos + Vector3.new(uDir.X, 0, uDir.Z))

            local camPos = cam and cam.CFrame.Position or origPos
            local camDiff = predPos - camPos
            local camUDir = (camDiff.Magnitude > 0.001) and camDiff.Unit or uDir

            SilentCache.Active           = true
            SilentCache.TargetPos        = predPos
            SilentCache.OriginPos        = origPos
            SilentCache.UnitDir          = uDir
            SilentCache.HitCFrame        = CFrame.lookAt(predPos, predPos + uDir)
            SilentCache.OriginLookCFrame = (diff.Magnitude > 0.05) and CFrame.lookAt(origPos, predPos) or flatCF
            SilentCache.FlatLookCFrame   = flatCF
            SilentCache.CamLookCFrame    = (camDiff.Magnitude > 0.05) and CFrame.lookAt(camPos, predPos) or SilentCache.OriginLookCFrame
            SilentCache.AimPart          = aimPart
            SilentCache.CameraPos        = camPos
            SilentCache.CamUnitDir       = camUDir
            return true
        end
    end
    SilentCache.Active = false
    return false
end

-- Steers skill BodyGyro, AlignOrientation, Character Facing & Dash BodyVelocity (Godhuman Z/C, CDK Z/X, Tiger Z/X/C) in the background
function Core.AlignSkillGyroToTarget()
    if not Config.SilentAim or not SilentCache.Active then return end
    local myChar = Core.GetCharacter(LocalPlayer)
    local myHrp  = Core.GetRootPart(LocalPlayer)
    if not myChar or not myHrp then return end

    local tPos = SilentCache.TargetPos
    if (tPos - myHrp.Position).Magnitude <= 0.1 then return end

    local lookCF = CFrame.lookAt(myHrp.Position, tPos)
    local flatPos = Vector3.new(tPos.X, myHrp.Position.Y, tPos.Z)
    local flatCF  = ((flatPos - myHrp.Position).Magnitude > 0.05) and CFrame.lookAt(myHrp.Position, flatPos) or lookCF

    local foundGyro = false
    for _, child in ipairs(myHrp:GetChildren()) do
        if child:IsA("BodyGyro") then
            child.CFrame = lookCF
            foundGyro = true
        elseif child:IsA("AlignOrientation") then
            child.CFrame = lookCF
            foundGyro = true
        elseif child:IsA("BodyVelocity") and not Core.IsCallerSoruScript() then
            -- Redirect skill dash velocity (like Godhuman Z/C or CDK X) toward the moving target in 3D
            local v = child.Velocity
            local speed = v.Magnitude
            local horizSpeed = Vector2.new(v.X, v.Z).Magnitude
            if speed >= 38 and speed <= 550 and horizSpeed >= 22 then
                local newVel = SilentCache.UnitDir * speed
                if (newVel - v).Magnitude > 1.5 then
                    child.Velocity = newVel
                end
            end
        end
    end

    -- If the move is winding up without a BodyGyro yet (like CDK Z/X or Godhuman startup), orient HRP horizontally toward target without altering velocity
    if not foundGyro and Core.IsSkillAimLockActive() then
        myHrp.CFrame = flatCF
    end
end

function Core.HookCharacterSkillMovers(char)
    if not char then return end
    task.spawn(function()
        local hrp = char:FindFirstChild("HumanoidRootPart") or char:WaitForChild("HumanoidRootPart", 8)
        if not hrp then return end

        local function InspectMover(inst)
            if not inst or State.HookedBodyMovers[inst] then return end
            if inst:IsA("BodyGyro") or inst:IsA("AlignOrientation") then
                State.HookedBodyMovers[inst] = true
                if Config.SilentAim and SilentCache.Active and Core.IsSkillAimLockActive() then
                    inst.CFrame = CFrame.lookAt(hrp.Position, SilentCache.TargetPos)
                end
                inst:GetPropertyChangedSignal("CFrame"):Connect(function()
                    if Config.SilentAim and SilentCache.Active and Core.IsSkillAimLockActive() and hrp.Parent then
                        local desired = CFrame.lookAt(hrp.Position, SilentCache.TargetPos)
                        if (inst.CFrame.LookVector - desired.LookVector).Magnitude > 0.02 then
                            inst.CFrame = desired
                        end
                    end
                end)
            elseif inst:IsA("BodyVelocity") then
                State.HookedBodyMovers[inst] = true
                local function TryRedirectDash()
                    if Config.SilentAim and SilentCache.Active and Core.IsSkillAimLockActive() and not Core.IsCallerSoruScript() then
                        local v = inst.Velocity
                        local speed = v.Magnitude
                        local horiz = Vector2.new(v.X, v.Z).Magnitude
                        if speed >= 38 and speed <= 550 and horiz >= 22 then
                            local targetVel = SilentCache.UnitDir * speed
                            if (inst.Velocity - targetVel).Magnitude > 1.5 then
                                inst.Velocity = targetVel
                            end
                        end
                    end
                end
                TryRedirectDash()
                inst:GetPropertyChangedSignal("Velocity"):Connect(TryRedirectDash)
            end
        end

        for _, child in ipairs(hrp:GetChildren()) do
            InspectMover(child)
        end
        hrp.ChildAdded:Connect(InspectMover)

        -- Also hook any equipped Tool so M1s & mobile skill activations lock immediately
        local function InspectTool(tool)
            if not tool or not tool:IsA("Tool") or State.HookedTools[tool] then return end
            State.HookedTools[tool] = true
            tool.Activated:Connect(function()
                Core.TriggerSkillAimWindow(0.95)
            end)
        end
        for _, child in ipairs(char:GetChildren()) do
            InspectTool(child)
        end
        char.ChildAdded:Connect(InspectTool)
    end)
end

function Core.TriggerSkillAimWindow(duration)
    local now = os.clock()
    State.LastSkillFireTick   = now
    State.LastSkillActionTick = now
    State.SkillAimEndTick     = math.max(State.SkillAimEndTick or 0, now + (duration or 1.35))
    if State.LockedTarget or State.CurrentTarget then
        State.SkillLockedTarget = State.LockedTarget or State.CurrentTarget
    end
    if Config.SilentAim then
        Core.UpdateSilentCacheFast()
        Core.AlignSkillGyroToTarget()
        if State.CommE and SilentCache.Active and (now - State.LastMousePosSyncTick > 0.025) then
            State.LastMousePosSyncTick = now
            local targetPos = SilentCache.TargetPos
            pcall(function()
                State.CommE:FireServer("MousePos", targetPos)
            end)
        end
    end
end

-- Caches SafeZone parts every 3 seconds so SafeZone checks take 0.001ms
function Core.RefreshSafeZoneCache()
    local now = os.clock()
    if now - State.LastSafeZoneCacheTick < 3.0 and #State.CachedSafeZoneParts > 0 then
        return
    end
    State.LastSafeZoneCacheTick = now
    local list = {}
    local worldOrigin = Workspace:FindFirstChild("_WorldOrigin")
    local safeZones = (worldOrigin and worldOrigin:FindFirstChild("SafeZones")) or Workspace:FindFirstChild("SafeZones")
    if safeZones then
        for _, zone in ipairs(safeZones:GetDescendants()) do
            if zone:IsA("BasePart") then
                local sx, sy, sz = zone.Size.X, zone.Size.Y, zone.Size.Z
                local mesh = zone:FindFirstChildOfClass("DataModelMesh")
                if mesh and sx <= 4 and sz <= 4 then
                    sx = mesh.Scale.X
                    sy = mesh.Scale.Y
                    sz = mesh.Scale.Z
                end
                table.insert(list, {
                    Part  = zone,
                    HalfX = sx * 0.5,
                    HalfY = math.max(sy * 0.5, 160),
                    HalfZ = sz * 0.5
                })
            end
        end
    end
    State.CachedSafeZoneParts = list
end

function Core.IsPositionInSafeZone(pos)
    Core.RefreshSafeZoneCache()
    local zones = State.CachedSafeZoneParts
    if #zones > 0 then
        for i = 1, #zones do
            local z = zones[i]
            if z.Part and z.Part.Parent then
                local rel = z.Part.CFrame:PointToObjectSpace(pos)
                if math.abs(rel.X) <= z.HalfX and math.abs(rel.Z) <= z.HalfZ and math.abs(rel.Y) <= z.HalfY then
                    return true
                end
            end
        end
        return false
    end

    for _, sz in ipairs(FallbackSafeZones) do
        local flatDist = Vector2.new(pos.X - sz.Pos.X, pos.Z - sz.Pos.Z).Magnitude
        if flatDist <= sz.Radius and math.abs(pos.Y - sz.Pos.Y) <= 180 then
            return true
        end
    end

    return false
end

