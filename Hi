                    return OnNamecallHook(oldNc, self, ...)
                end)
                NamecallHooked = true
            end
            if not IndexHooked and rawMt.__index then
                local oldIdx = rawMt.__index
                rawMt.__index = newcclosure(function(self, key)
                    return OnIndexHook(oldIdx, self, key)
                end)
                IndexHooked = true
            end
            setreadonly(rawMt, true)
        end)
    end

    -- 3. Fallback to hookfunction on RemoteEvent.FireServer
    if not NamecallHooked and hookfunction then
        pcall(function()
            local dummyRemote = Instance.new("RemoteEvent")
            local oldFireServer
            oldFireServer = hookfunction(dummyRemote.FireServer, newcclosure(function(self, ...)
                if not checkcaller() and typeof(self) == "Instance" then
                    local a1, a2, a3, a4, a5, a6 = ...
                    if type(a1) == "string" and type(a2) == "number" and type(a4) == "table" and (type(a6) == "string" or type(a5) == "string") then
