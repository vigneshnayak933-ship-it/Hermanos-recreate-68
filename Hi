-- 4. Keyboard InputBegan & InputEnded Handlers
do
    local SkillKeyMap = {
        [Enum.KeyCode.Z] = true,
        [Enum.KeyCode.X] = true,
        [Enum.KeyCode.C] = true,
        [Enum.KeyCode.V] = true,
        [Enum.KeyCode.F] = true
    }

    table.insert(State.Connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if SkillKeyMap[input.KeyCode] then
            Core.TriggerSkillAimWindow(1.50)
        end

        if gameProcessed then return end

        if input.KeyCode == Config.Key_ToggleUI then
            UI.ToggleMainWindow()
        elseif input.KeyCode == Config.Key_CameraLock then
            Config.CameraLock = not Config.CameraLock
            if UI.CamLockToggleRef then
                UI.CamLockToggleRef.Set(Config.CameraLock, false)
            end
            if Config.CameraLock then
                State.LockedTarget = Core.GetBestTarget()
                if State.LockedTarget then
                    Core.TagPlayerInCombatWithMe(State.LockedTarget, 65)
                end
                UI.CamLockStroke.Color = Theme.HudRedText
                UI.CamLockStroke.Transparency = 0
                UI.CamLockBtn.TextColor3 = Color3.fromRGB(255, 215, 55)
            else
                State.LockedTarget = nil
                UI.CamLockStroke.Color = Color3.fromRGB(52, 55, 64)
                UI.CamLockStroke.Transparency = 0.25
                UI.CamLockBtn.TextColor3 = Theme.HudRedText
            end
        elseif input.KeyCode == Config.Key_TPToTarget then
            local target = State.LockedTarget or State.CurrentTarget or Core.GetBestTarget()
            if target and Core.IsPlayerAlive(target) then
                local myHrp = Core.GetRootPart(LocalPlayer)
                local tHrp  = Core.GetRootPart(target)
                if myHrp and tHrp then
                    Core.TagPlayerInCombatWithMe(target, 65)
                    Core.TryPortalBypass(tHrp.Position)
                    myHrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
                end
            end
        elseif input.KeyCode == Config.Key_SkipTarget then
            local cur = State.LockedTarget or State.CurrentTarget
            if cur then
                State.BlacklistedTargets[cur.UserId] = true
                State.CombatTaggedPlayers[cur.UserId] = nil
                State.InCombatWithMe[cur.UserId] = nil
                State.LockedTarget = nil
                State.SkillLockedTarget = nil
                State.CurrentTarget = nil
                UI.Notify("Target Skipped", "Blacklisted " .. cur.Name, 2)
            end
        elseif input.KeyCode == Config.Key_SoruSilent then
            if Config.SoruSilent then
                Core.UpdateSilentCacheFast()
                Core.TryExecuteSoruSilentTeleport()
            else
                State.NormalSoruBypassTick = os.clock() + 0.45
            end
        end
    end))

    table.insert(State.Connections, UserInputService.InputEnded:Connect(function(input)
        if SkillKeyMap[input.KeyCode] then
            Core.TriggerSkillAimWindow(1.35)
        end
    end))
end

