                        end

                        Core.AlignSkillGyroToTarget()

                        -- Instant non-yielding MousePos sync in the exact same network tick
                        if State.CommE and rName ~= "LeftClickRemote" and (now - State.LastMousePosSyncTick > 0.025) then
                            State.LastMousePosSyncTick = now
