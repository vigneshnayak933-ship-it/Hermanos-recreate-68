local WallPhaseParams = RaycastParams.new()
WallPhaseParams.FilterType = Enum.RaycastFilterType.Exclude
WallPhaseParams.IgnoreWater = true

-- 2. Stepped: Speed Boost, Jump Power, Small-Wall Phase, Anti-Stun, Walk On Water, Skill Physics Lock & Pursuit
table.insert(State.Connections, RunService.Stepped:Connect(function(_, dt)
    local char = Core.GetCharacter(LocalPlayer)
    local hum  = Core.GetHumanoid(LocalPlayer)
    local hrp  = Core.GetRootPart(LocalPlayer)
    if not char or not hum or not hrp or hum.Health <= 0 then return end

    if Config.SilentAim and SilentCache.Active and Core.IsSkillAimLockActive() then
        Core.UpdateSilentCacheFast()
        Core.AlignSkillGyroToTarget()
    end

    if Config.AntiStun then
        local stunObj = char:FindFirstChild("Stun") or hum:FindFirstChild("Stun")
        if stunObj and stunObj:IsA("ValueBase") and stunObj.Value ~= 0 then
            stunObj.Value = 0
        end
        if hum.PlatformStand then
            hum.PlatformStand = false
        end
    end

    if Config.JumpPower then
        hum.UseJumpPower = true
        hum.JumpPower = Config.JumpPowerValue
    end

    if Config.SpeedBoost and hum.MoveDirection.Magnitude > 0 then
        local flatMove = Vector3.new(hum.MoveDirection.X, 0, hum.MoveDirection.Z)
        if flatMove.Magnitude > 0.001 then
            local moveDir = flatMove.Unit
            local mult = math.clamp(Config.SpeedMultiply, 1, 50)
            local stepStuds = (mult * 0.30) * math.min(dt * 60, 2.5)
            hrp.CFrame = hrp.CFrame + (moveDir * stepStuds)

            if os.clock() - State.LastPhaseTick > 0.12 then
                WallPhaseParams.FilterDescendantsInstances = { char, WorldVisualsFolder }
                local hitForward = Workspace:Raycast(hrp.Position, moveDir * 2.6, WallPhaseParams)
                if hitForward and hitForward.Instance and hitForward.Instance.CanCollide then
                    local testPos = hrp.Position + (moveDir * 6.5)
                    local hitInside = Workspace:Raycast(testPos, -moveDir * 5.5, WallPhaseParams)
                    if hitInside and hitInside.Instance == hitForward.Instance then
                        local thickness = (hitInside.Position - hitForward.Position).Magnitude
                        if thickness <= 8.5 then
                            State.LastPhaseTick = os.clock()
                            hrp.CFrame = hrp.CFrame + (moveDir * (thickness + 2.2))
                        end
                    end
                end
            end
        end
    end

    if Config.WalkOnWater then
        local map = Workspace:FindFirstChild("Map")
        local waterPlane = map and map:FindFirstChild("WaterBase-Plane")
        if waterPlane and waterPlane.Size.Y < 110 then
            waterPlane.Size = Vector3.new(1000, 112, 1000)
        end
    end

    if Config.InfiniteEnergy then
        local energyObj = char:FindFirstChild("Energy")
        if energyObj and energyObj:IsA("ValueBase") then
            energyObj.Value = energyObj.MaxValue or 15000
        end
    end

    if Config.InvisiblePlus then
        local rootJoint = hrp:FindFirstChild("RootJoint")
        if rootJoint and rootJoint:IsA("Motor6D") then
            rootJoint.C0 = CFrame.new(0, 0, 0) * CFrame.Angles(math.rad(-90), 0, math.rad(180))
        end
    end

    local activeTarget = State.LockedTarget or State.CurrentTarget
    if Config.TeleportBehideTarget and activeTarget and Core.IsPlayerAlive(activeTarget) then
        local tHrp = Core.GetRootPart(activeTarget)
        if tHrp then
            local dist = (hrp.Position - tHrp.Position).Magnitude
            if dist <= Config.TeleportBehideRange then
                Core.TagPlayerInCombatWithMe(activeTarget, 65)
                hrp.CFrame = tHrp.CFrame * CFrame.new(0, Config.TeleportOffsetY, Config.TeleportOffsetZ)
            end
        end
    end
end))

