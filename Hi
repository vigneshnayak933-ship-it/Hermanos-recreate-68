-- Returns true while holding a move AND during the entire windup/launch animation (like CDK Z/X & Godhuman Z/C) until the attack completes
function Core.IsSkillAimLockActive()
    local now = os.clock()
    if Core.IsHoldingSkillKey() or now < State.SkillAimEndTick then
        return true
    end
    if (now - State.LastSkillActionTick) < 2.4 then
        local myChar = Core.GetCharacter(LocalPlayer)
        local myHrp  = Core.GetRootPart(LocalPlayer)
        if myChar then
            local busyVal = myChar:FindFirstChild("Busy")
            if busyVal and busyVal:IsA("ValueBase") and busyVal.Value == true then
                return true
            end
        end
        if myHrp then
            if myHrp:FindFirstChildOfClass("BodyGyro") or myHrp:FindFirstChildOfClass("AlignOrientation") or myHrp:FindFirstChildOfClass("BodyPosition") then
                return true
            end
        end
    end
    return false
end

function Core.FormatCompactNumber(n)
    n = tonumber(n) or 0
    if n >= 1e9 then
        return string.format("%.2fB", n / 1e9)
    elseif n >= 1e6 then
        return string.format("%.2fM", n / 1e6)
    elseif n >= 1e3 then
        return string.format("%.1fK", n / 1e3)
    end
    return tostring(math.floor(n))
end

function Core.TryPortalBypass(targetPos)
    if not Config.BypassTP or not State.CommF_ then return false end
    local myHrp = Core.GetRootPart(LocalPlayer)
    if not myHrp then return false end
    local activePortalMap = State.IsSea3 and PortalLocations.Sea3 or (State.IsSea2 and PortalLocations.Sea2 or (State.IsSea1 and PortalLocations.Sea1 or nil))
    if not activePortalMap then return false end

    local currentDist = (myHrp.Position - targetPos).Magnitude
    local bestPortalVec = nil
    local shortestDist = currentDist

    for _, portalVec in pairs(activePortalMap) do
        local distFromPortal = (portalVec - targetPos).Magnitude
        if (distFromPortal + 300) < shortestDist then
            shortestDist = distFromPortal
            bestPortalVec = portalVec
        end
    end

    if bestPortalVec then
        pcall(function()
            State.CommF_:InvokeServer("requestEntrance", bestPortalVec)
        end)
        return true
    end
    return false
end

